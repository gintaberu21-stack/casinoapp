# MongoDB Atlas の接続文字列。パスワードを含むのでこのファイルには書かず、
# ローカルは .env に、本番は Render のダッシュボードの Environment に入れること。
# 例: mongodb+srv://ユーザー名:パスワード@クラスタ.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# 使うデータベース名（省略時は casino_duel）
MONGODB_DB=casino_duel

# ローカルで動かすときのポート（Render では自動で設定される）
PORT=3000

# 共有した人だけが入れる合言葉。未設定ならローカル開発用にゲートを無効化する。
ACCESS_CODE=change-this-shared-code

# 合言葉Cookieの署名用。Renderでは自動生成する。
ACCESS_TOKEN_SECRET=change-this-long-random-secret
